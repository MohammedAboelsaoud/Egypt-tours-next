# ---- Database ----
DATABASE_URL="postgresql://user:password@localhost:5432/egypt_journeys"

# ---- NextAuth (Auth.js v5) ----
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---- OAuth (optional — providers are skipped when left empty) ----
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# ---- Stripe ----
# Leave empty to run the booking flow in mock-payment mode (dev only).
# Test keys (sk_test_/pk_test_) take test cards; live keys take real payments.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Signing secret for /api/payments/stripe/webhook (whsec_…).
STRIPE_WEBHOOK_SECRET=""

# ---- Cloudinary (image uploads; falls back to URL-paste when empty) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Resend (transactional email; logged to console when empty) ----
RESEND_API_KEY=""
EMAIL_FROM="Egypt Journeys <noreply@egyptjourneys.com>"
ADMIN_EMAIL="admin@egyptjourneys.com"

# ---- Google Maps (map renders a static fallback when empty) ----
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ---- App ----
NEXT_PUBLIC_SITE_NAME="Egypt Journeys"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="201029350015"

# ---- Seed admin account ----
SEED_ADMIN_EMAIL="admin@egyptjourneys.com"
SEED_ADMIN_PASSWORD="Admin123!"
