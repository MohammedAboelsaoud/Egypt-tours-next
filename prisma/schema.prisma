// Egypt Journeys — database schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
  GUIDE
}

enum GuideStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum GuideRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum BookingType {
  TOUR
  HOTEL
  CAR
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role           @default(CUSTOMER)
  phone         String?
  nationality   String?
  passportNo    String?
  /// Languages the traveller speaks, used to match them with a guide.
  languages     String[]       @default([])
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  reviews       Review[]
  wishlists     Wishlist[]
  guideProfile  GuideProfile?
  guideRequests GuideRequest[]
  guideReviews  GuideReview[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Region {
  id        String         @id @default(cuid())
  slug      String         @unique
  name      String
  tagline   String         @default("")
  summary   String         @db.Text
  cities    String[]
  imageUrl  String
  lat       Float?
  lng       Float?
  zoom      Int            @default(7)
  sortOrder Int            @default(0)
  published Boolean        @default(true)
  tours     Tour[]
  hotels    Hotel[]
  cars      Car[]
  guides    GuideProfile[]
  sites     HistoricSite[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Tour {
  id           String     @id @default(cuid())
  slug         String     @unique
  title        String
  summary      String     @db.Text
  description  String     @db.Text
  durationDays Int        @default(1)
  priceFrom    Decimal    @db.Decimal(10, 2)
  currency     String     @default("USD")
  maxGroupSize Int        @default(20)
  highlights   String[]
  itinerary    Json
  includes     String[]
  excludes     String[]
  imageUrl     String
  galleryUrls  String[]
  lat          Float?
  lng          Float?
  featured     Boolean    @default(false)
  published    Boolean    @default(true)
  sortOrder    Int        @default(0)
  regionId     String
  region       Region     @relation(fields: [regionId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  reviews      Review[]
  wishlists    Wishlist[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([regionId])
}

model Hotel {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  description   String    @db.Text
  starRating    Int       @default(4)
  imageUrl      String
  galleryUrls   String[]
  amenities     String[]
  pricePerNight Decimal   @db.Decimal(10, 2)
  currency      String    @default("USD")
  maxGuests     Int       @default(2)
  roomTypes     Json?
  address       String?
  lat           Float?
  lng           Float?
  published     Boolean   @default(true)
  regionId      String
  region        Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([regionId])
}

model Car {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  description  String    @db.Text
  brand        String
  model        String
  year         Int
  type         String
  seats        Int       @default(4)
  transmission String    @default("Automatic")
  fuelType     String    @default("Petrol")
  imageUrl     String
  galleryUrls  String[]
  pricePerDay  Decimal   @db.Decimal(10, 2)
  currency     String    @default("USD")
  features     String[]
  available    Boolean   @default(true)
  published    Boolean   @default(true)
  regionId     String
  region       Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([regionId])
}

model Booking {
  id              String        @id @default(cuid())
  reference       String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingType     BookingType
  tourId          String?
  tour            Tour?         @relation(fields: [tourId], references: [id])
  hotelId         String?
  hotel           Hotel?        @relation(fields: [hotelId], references: [id])
  carId           String?
  car             Car?          @relation(fields: [carId], references: [id])
  checkIn         DateTime
  checkOut        DateTime
  guests          Int           @default(1)
  totalPrice      Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  status          BookingStatus @default(PENDING)
  paymentId       String?
  paymentStatus   PaymentStatus @default(PENDING)
  /// CASH: reserved now, paid in cash on the day; an admin marks it PAID.
  paymentMethod   PaymentMethod @default(CARD)
  cancelledAt     DateTime?
  /// Amount refunded to the card when the traveller cancelled.
  refundAmount    Decimal?      @db.Decimal(10, 2)
  refundId        String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  nationality     String?
  passportNo      String?
  specialRequests String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  destination String?
  partySize   String?
  travelDates String?
  message     String   @db.Text
  planTitle   String?
  handled     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tourId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, tourId])
}

/// Singleton row (id = "site") holding admin-editable site settings.
model SiteSetting {
  id             String   @id @default("site")
  siteName       String   @default("Egypt Journeys")
  tagline        String   @default("Egypt, Planned Around You")
  contactEmail   String   @default("muhammedaboelsaoud@gmail.com")
  contactPhone   String   @default("+20 102 935 0015")
  whatsappNumber String   @default("201029350015")
  address        String   @default("Zamalek, Cairo, Egypt")
  facebookUrl    String   @default("")
  instagramUrl   String   @default("")
  /// Legacy, unused since the switch to Stripe. Kept because production
  /// databases still hold a value here, and removing the field would make
  /// schema pushes drop that data (and so refuse to run).
  paypalMode     String   @default("sandbox")
  updatedAt      DateTime @default(now()) @updatedAt
}

/// One-time data loads that have already run (e.g. the starter historic-sites
/// catalog), so they never run twice — see lib/db/ensure-schema.ts. A table of
/// its own because preview builds read existing tables before any schema sync.
model DataLoad {
  id       String   @id
  loadedAt DateTime @default(now())
}

/// A page in the historic sites catalog (/sites): the history of a monument,
/// with key facts, visiting tips and photos.
model HistoricSite {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  /// e.g. "Giza plateau, western edge of Cairo"
  location    String   @default("")
  /// e.g. "c. 2600–2500 BC (4th Dynasty)"
  period      String   @default("")
  summary     String   @db.Text
  /// The history. "## Heading" lines start chapters; blank lines split paragraphs.
  history     String   @db.Text
  /// "Label: value" lines, shown as the key-facts panel.
  facts       String[] @default([])
  tips        String[] @default([])
  imageUrl    String
  /// Photographer and licence, when the photo isn't the owner's.
  imageCredit String   @default("")
  galleryUrls String[] @default([])
  /// Words that make the chat assistant link to this page.
  keywords    String[] @default([])
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  regionId    String
  region      Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([regionId])
}

/// A tour guide's public profile. Visible to travellers once an admin approves it.
model GuideProfile {
  id              String            @id @default(cuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String            @unique
  displayName     String
  guideType       String
  bio             String            @db.Text
  photoUrl        String?
  licenceNumber   String?
  yearsExperience Int               @default(0)
  languages       String[]
  specialties     String[]
  regions         Region[]
  dayRate         Decimal?          @db.Decimal(10, 2)
  currency        String            @default("USD")
  whatsapp        String
  status          GuideStatus       @default(PENDING)
  adminNote       String?
  blockedDays     GuideBlockedDay[]
  requests        GuideRequest[]
  reviews         GuideReview[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
}

/// A day the guide has marked as unavailable (holiday, outside work).
model GuideBlockedDay {
  id      String       @id @default(cuid())
  guideId String
  guide   GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)
  date    DateTime     @db.Date

  @@unique([guideId, date])
}

/// A traveller asking a guide for a run of whole days. Only ACCEPTED requests
/// occupy the guide's calendar.
model GuideRequest {
  id          String             @id @default(cuid())
  reference   String             @unique
  guideId     String
  guide       GuideProfile       @relation(fields: [guideId], references: [id], onDelete: Cascade)
  touristId   String
  tourist     User               @relation(fields: [touristId], references: [id], onDelete: Cascade)
  /// First and last day of the trip, both inclusive.
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  groupSize   Int
  message     String             @db.Text
  status      GuideRequestStatus @default(PENDING)
  guideReply  String?            @db.Text
  respondedAt DateTime?
  review      GuideReview?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([guideId, status, startDate])
  @@index([touristId])
}

/// One review per completed trip, shown immediately; admins can hide abuse.
model GuideReview {
  id        String       @id @default(cuid())
  guideId   String
  guide     GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)
  touristId String
  tourist   User         @relation(fields: [touristId], references: [id], onDelete: Cascade)
  requestId String       @unique
  request   GuideRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String       @db.Text
  hidden    Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([guideId])
}
